# Public — safe to expose to the browser (read-only, RLS-protected)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by /api/admin-save.ts, NEVER prefix with VITE_
# (that prefix is what makes Vite ship a var to the browser bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=choose-a-password

# Server-only — used by /api/survivor-auth.ts, gates the private #survivor page
SURVIVOR_PASSWORD=choose-a-different-password

# Server-only — used by /api/odds-feed.ts (the-odds-api.com), powers the Odds page
ODDS_API_KEY=your-odds-api-key

# Server-only — used by /api/admin-bets-save.ts's juicereel* actions and
# /api/juicereel-oauth-callback.ts. From a JuiceReel OAuth application
# (juicereel.com/settings/oauth-applications), redirect URI must be
# exactly https://ycpr.vercel.app/api/juicereel-oauth-callback
JUICEREEL_CLIENT_ID=your-juicereel-client-id
JUICEREEL_CLIENT_SECRET=your-juicereel-client-secret
