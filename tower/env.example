# Copy to ~/YCPR/.env on the tower (cp tower/env.example .env), fill in, then: chmod 600 .env
# Never commit .env or paste these values into a chat.
SUPABASE_URL=https://uyxnmtsntiaxqqmwsteq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PROPHETX_ACCESS_KEY=
PROPHETX_SECRET_KEY=
# Discord alerts (private "YCPR alerts" server): channel webhook URLs from Edit Channel → Integrations → Webhooks.
# #bot gets errors; #usage gets the daily Supabase usage report at 9am ET (falls back to #bot if unset).
DISCORD_WEBHOOK_URL=
DISCORD_USAGE_WEBHOOK_URL=
# Optional: overnight quiet hours in Eastern time ("start-end"), or "off". Default 21-9.
# BOT_QUIET_HOURS=21-9
